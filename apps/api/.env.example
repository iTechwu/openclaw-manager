# =============================================================================
# ClawBot Manager - 统一配置文件模板
# =============================================================================
# 复制此文件为 .env 并填入实际值
# cp apps/api/.env.example apps/api/.env
# =============================================================================

# --- 环境配置 ---
NODE_ENV=dev

# --- 服务端口 ---
API_PORT=3200
WEB_PORT=13000

# --- 基础主机 ---
BASE_HOST=127.0.0.1

# =============================================================================
# 核心基础设施
# =============================================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql://user:password@${BASE_HOST}:5432/clawbot_manager?schema=public&timezone=Asia/Shanghai
READ_DATABASE_URL=postgresql://user:password@${BASE_HOST}:5432/clawbot_manager?schema=public&timezone=Asia/Shanghai

# --- Redis ---
REDIS_URL=redis://:password@${BASE_HOST}:6379/0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://user:password@${BASE_HOST}:5672/nestjs_xica
RABBITMQ_EVENTS_URL="amqp://user:password@${BASE_HOST}:5672/nestjs_to_agentx_events"

# =============================================================================
# 安全配置
# =============================================================================

# --- JWT (从 config.local.yaml 迁移) ---
JWT_SECRET=your-jwt-secret-at-least-8-characters
JWT_EXPIRE_IN=3600

# --- Crypto (从 config.local.yaml 迁移) ---
CRYPTO_KEY=your-crypto-key
CRYPTO_IV=your-crypto-iv

# --- Pinecone API Key (从 config.local.yaml 迁移) ---
PINECONE_API_KEY=your-pinecone-api-key

# --- Bot API Secrets (auto-generated) ---
BOT_MASTER_KEY=your-bot-master-key

# =============================================================================
# Zero-Trust Mode 配置
# =============================================================================
ZERO_TRUST_MODE=true
PROXY_PREFER_STATS=true
PROXY_TOKEN_TTL=86400

# =============================================================================
# 数据目录配置 (本地开发)
# =============================================================================
DATA_DIR=./data
SECRETS_DIR=./secrets
DATA_VOLUME_NAME=clawbot-manager-data
SECRETS_VOLUME_NAME=clawbot-manager-secrets

BOT_DATA_DIR=${DATA_DIR}/bots
BOT_SECRETS_DIR=${SECRETS_DIR}/bots
BOT_OPENCLAW_DIR=${DATA_DIR}/openclaw

# =============================================================================
# Bot 镜像配置
# =============================================================================
BOT_IMAGE_GATEWAY=openclaw:local
BOT_IMAGE_TOOL_SANDBOX=openclaw-sandbox:bookworm-slim
BOT_IMAGE_BROWSER_SANDBOX=openclaw-sandbox-browser:bookworm-slim

BOT_PORT_START=19000
BOT_CONTAINER_CPU_LIMIT=1
BOT_CONTAINER_MEMORY_LIMIT=2147483648

# =============================================================================
# Docker 构建配置
# =============================================================================
DOCKER_PLATFORM=linux/arm64
BASE_NODE_IMAGE=node:24.1-slim
DOCKER_REGISTRY=your-registry.com/namespace
DOCKER_IMAGE_TAG=latest
OPENCLAW_SRC_PATH=../openclaw

# =============================================================================
# 外部服务 URL
# =============================================================================
API_BASE_URL=http://${BASE_HOST}:${API_PORT}/api
INTERNAL_API_BASE_URL=http://${BASE_HOST}:${API_PORT}/api

# =============================================================================
# 飞书配置
# =============================================================================
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_DOMAIN=feishu

# =============================================================================
# NPM 配置
# =============================================================================
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# =============================================================================
# 日志配置
# =============================================================================
LOG_LEVEL=info
