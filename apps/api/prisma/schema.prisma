generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// ============================================================================
// User System - 用户系统
// ============================================================================
enum SexType {
  UNKNOWN
  MALE
  FEMALE

  @@map("sex_type")
}

model UserInfo {
  id           String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nickname     String  @default("") @db.VarChar(255)
  code         String? @unique @db.VarChar(255)
  avatarFileId String? @map("avatar_file_id") @db.Uuid
  sex          SexType @default(UNKNOWN)
  locale       String? @db.VarChar(20)
  isAnonymity  Boolean @default(false) @map("is_anonymity")
  isAdmin      Boolean @default(false) @map("is_admin")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Account Identifiers (登录标识)
  deviceId      String? @unique @map("device_id") @db.VarChar(255)
  wechatOpenid  String? @unique @map("wechat_openid") @db.VarChar(255)
  wechatUnionId String? @unique @map("wechat_union_id") @db.VarChar(255)
  googleSub     String? @unique @map("google_sub") @db.VarChar(255)
  discordId     String? @unique @map("discord_id") @db.VarChar(255)
  mobile        String? @unique @map("mobile") @db.VarChar(40)
  email         String? @unique @map("email") @db.VarChar(255)

  // Relations
  avatarFile       FileSource?        @relation(fields: [avatarFileId], references: [id], onDelete: SetNull)
  wechatAuth       WechatAuth?
  googleAuth       GoogleAuth?
  discordAuth      DiscordAuth?
  mobileAuth       MobileAuth?
  emailAuth        EmailAuth?
  sentMessages     Message[]          @relation("SentMessages")
  receivedMessages MessageRecipient[] @relation("ReceivedMessages")
  bots             Bot[]
  providerKeys     ProviderKey[]
  personaTemplates PersonaTemplate[]
  operateLogs      OperateLog[]

  @@index([code])
  @@index([isDeleted, isAdmin])
  @@index([createdAt(sort: Desc)])
  @@index([nickname])
  @@index([avatarFileId])
  @@index([deviceId])
  @@index([wechatOpenid])
  @@index([googleSub])
  @@index([discordId])
  @@index([mobile])
  @@index([email])
  @@map("u_user_info")
}

// ============================================================================
// Persona Template System - 人格模板系统（须在 UserInfo 后、被引用前定义）
// ============================================================================

/// PersonaTemplate - 人格模板
/// 支持系统预设模板和用户自定义模板
/// 图标支持两种形式（二选一）：
/// - emoji: emoji 字符串（如 "🤖"）
/// - avatarFileId: 上传的头像文件 ID（关联 FileSource）
model PersonaTemplate {
  id           String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String  @db.VarChar(255)
  emoji        String? @db.VarChar(10)
  avatarFileId String? @map("avatar_file_id") @db.Uuid
  tagline      String  @db.VarChar(500)
  soulMarkdown String  @map("soul_markdown") @db.Text
  soulPreview  String? @map("soul_preview") @db.VarChar(500)
  isSystem     Boolean @default(false) @map("is_system")
  locale       String  @default("en") @db.VarChar(10) // en, zh-CN
  createdById  String? @map("created_by_id") @db.Uuid

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdBy  UserInfo?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  avatarFile FileSource? @relation(fields: [avatarFileId], references: [id], onDelete: SetNull)
  bots       Bot[]

  @@index([isSystem])
  @@index([createdById])
  @@index([avatarFileId])
  @@index([isDeleted])
  @@index([locale])
  @@index([createdAt(sort: Desc)])
  @@map("b_persona_template")
}

// ============================================================================
// Auth Tables - 认证信息表（只存 token/password，不存 userId）
// ============================================================================

model WechatAuth {
  openid       String    @unique @db.VarChar(255)
  sessionKey   String?   @map("session_key") @db.Text
  refreshToken String?   @map("refresh_token") @db.Text
  isDeleted    Boolean   @default(false) @map("is_deleted")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user UserInfo @relation(fields: [openid], references: [wechatOpenid], onDelete: Cascade)

  @@index([openid])
  @@map("u_wechat_auth")
}

model GoogleAuth {
  sub           String    @unique @db.VarChar(255)
  email         String    @db.VarChar(255)
  verifiedEmail Boolean   @default(true) @map("verified_email")
  atHash        String?   @map("at_hash") @db.VarChar(255)
  name          String?   @db.VarChar(255)
  picture       String?   @db.Text
  givenName     String?   @map("given_name") @db.VarChar(255)
  familyName    String?   @map("family_name") @db.VarChar(255)
  exp           Int
  iat           Int
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  user UserInfo @relation(fields: [sub], references: [googleSub], onDelete: Cascade)

  @@index([sub])
  @@index([email])
  @@map("u_google_auth")
}

model DiscordAuth {
  discordId     String    @unique @map("discord_id") @db.VarChar(255)
  email         String    @db.VarChar(255)
  verifiedEmail Boolean   @default(true) @map("verified_email")
  name          String?   @db.VarChar(255)
  accessToken   String?   @map("access_token") @db.Text
  refreshToken  String?   @map("refresh_token") @db.Text
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  user UserInfo @relation(fields: [discordId], references: [discordId], onDelete: Cascade)

  @@index([discordId])
  @@index([email])
  @@map("u_discord_auth")
}

model MobileAuth {
  mobile    String    @unique @db.VarChar(40)
  password  String    @db.VarChar(255)
  verified  Boolean   @default(false)
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user UserInfo @relation(fields: [mobile], references: [mobile], onDelete: Cascade)

  @@index([mobile])
  @@map("u_mobile_auth")
}

model EmailAuth {
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  verified  Boolean   @default(false)
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user UserInfo @relation(fields: [email], references: [email], onDelete: Cascade)

  @@index([email])
  @@map("u_email_auth")
}

// ============================================================================
// Risk Detection - 风险检测记录
// ============================================================================

model RiskDetectionRecord {
  id        String    @id @db.VarChar(255)
  action    String    @db.VarChar(100)
  data      Json?
  status    Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([action])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("risk_detection_record")
}

// ============================================================================
// System Task Queue - 系统任务队列（短信/邮件发送历史）
// RabbitMQ + BullMQ（队列调度层）
// SystemTaskQueue 只在任务最终完成（成功/失败）后写入，用于审计、统计、用户查询发送历史
// 不参与队列调度和重试逻辑
// ============================================================================

enum TaskType {
  SMS
  EMAIL
  PUSH

  @@map("task_type")
}

enum TaskStatus {
  SUCCESS
  FAILED

  @@map("task_status")
}

model SystemTaskQueue {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  taskType     TaskType   @map("task_type")
  status       TaskStatus
  recipient    String     @db.VarChar(255)
  templateCode String?    @map("template_code") @db.VarChar(100)
  templateData Json?      @map("template_data")
  content      String?    @db.Text
  subject      String?    @db.VarChar(500)
  retryCount   Int        @default(0) @map("retry_count")
  processedAt  DateTime   @map("processed_at") @db.Timestamptz(6)
  errorMessage String?    @map("error_message") @db.Text
  metadata     Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([taskType, status])
  @@index([recipient, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("system_task_queue")
}

enum FileBucketVendor {
  oss
  us3
  qiniu
  s3
  gcs
  tos
  tencent
  ksyun

  @@map("file_bucket_vendor")
}

enum FileEnvType {
  dev
  test
  prod
  produs
  prodap

  @@map("file_env_type")
}

model FileSource {
  id                        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  isUploaded                Boolean          @default(false) @map("is_uploaded")
  bucket                    String           @db.VarChar(255)
  key                       String           @unique @db.VarChar(255)
  hash                      String?          @db.VarChar(255)
  thumbImg                  String?          @map("thumb_img") @db.VarChar(255)
  fsize                     Float            @default(0)
  mimeType                  String           @default("") @map("mime_type") @db.VarChar(255)
  type                      Int              @default(0)
  endUser                   String?          @map("end_user") @db.VarChar(255)
  status                    Int              @default(0)
  sha256                    String?          @db.VarChar(255)
  parts                     Int[]
  ext                       String           @default("") @db.VarChar(255)
  expireAt                  DateTime?        @map("expire_at") @db.Timestamptz(6)
  transitionToIaAt          DateTime?        @map("transition_to_ia_at") @db.Timestamptz(6)
  transitionToArchiveAt     DateTime?        @map("transition_to_archive_at") @db.Timestamptz(6)
  transitionToDeepArchiveAt DateTime?        @map("transition_to_deep_archive_at") @db.Timestamptz(6)
  transitionToArchiveIRAt   DateTime?        @map("transition_to_archive_ir_at") @db.Timestamptz(6)
  env                       FileEnvType      @default(prod)
  vendor                    FileBucketVendor @default(us3)
  region                    String           @default("cn-beijing")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  userAvatars      UserInfo[]
  personaTemplates PersonaTemplate[]
  botAvatars       Bot[]

  @@index([fsize, sha256])
  @@index([isDeleted])
  @@index([isUploaded])
  @@index([bucket])
  @@index([key])
  @@map("f_file_source")
}

model CountryCode {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  continent String    @db.VarChar(10) // us, eu, ap, cn
  code      String    @db.VarChar(10) // 国家代码，如 CN, US, SG
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([continent, code])
  @@index([continent])
  @@index([code])
  @@map("country_code")
}

// ============================================================================
// Bot Management System - Bot 管理系统
// ============================================================================

enum BotStatus {
  draft // 草稿状态，未配置完成
  created
  starting
  running
  stopped
  error

  @@map("bot_status")
}

/// Bot 健康状态
enum HealthStatus {
  HEALTHY
  UNHEALTHY
  UNKNOWN

  @@map("health_status")
}

/// Bot 类型 - Bot 容器类型
/// 决定使用哪种 Docker 镜像运行 Bot
enum BotType {
  GATEWAY         // 主 Gateway bot（默认）- 使用 openclaw:local 镜像
  TOOL_SANDBOX    // 工具沙箱容器 - 使用 openclaw-sandbox 镜像
  BROWSER_SANDBOX // 浏览器沙箱容器 - 使用 openclaw-sandbox-browser 镜像，支持 VNC

  @@map("bot_type")
}

/// Bot - 机器人实体
/// 管理 AI 机器人的生命周期和配置
/// 注意：aiProvider、model、channelType 字段已移除，这些值从 BotModel 和 BotChannel 动态派生
model Bot {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name              String    @db.VarChar(255)
  hostname          String    @db.VarChar(64)
  containerId       String?   @map("container_id") @db.VarChar(255)
  port              Int?
  gatewayToken      String?   @map("gateway_token") @db.VarChar(255)
  proxyTokenHash    String?   @map("proxy_token_hash") @db.VarChar(64)
  tags              String[]
  status            BotStatus @default(created)
  createdById       String    @map("created_by_id") @db.Uuid
  personaTemplateId String?   @map("persona_template_id") @db.Uuid
  emoji             String?   @db.VarChar(10)
  avatarFileId      String?   @map("avatar_file_id") @db.Uuid
  soulMarkdown      String?   @map("soul_markdown") @db.Text

  // 待生效配置：存储修改后尚未重启生效的配置
  // 包含 name, tags, soulMarkdown, emoji 等字段的待生效值
  pendingConfig Json? @map("pending_config") @db.JsonB

  // 健康检查字段
  healthStatus    HealthStatus @default(UNKNOWN) @map("health_status")
  lastHealthCheck DateTime?    @map("last_health_check") @db.Timestamptz(6)

  // Bot 类型字段 - 决定使用哪种 Docker 镜像
  botType BotType @default(GATEWAY) @map("bot_type")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  createdBy          UserInfo          @relation(fields: [createdById], references: [id])
  personaTemplate    PersonaTemplate?  @relation(fields: [personaTemplateId], references: [id], onDelete: SetNull)
  avatarFile         FileSource?       @relation(fields: [avatarFileId], references: [id], onDelete: SetNull)
  usageLogs          BotUsageLog[]
  proxyToken         ProxyToken?
  plugins            BotPlugin[]
  skills             BotSkill[]
  channels           BotChannel[]
  modelRoutings      BotModelRouting[]
  routingConfig      BotRoutingConfig?
  models             BotModel[]
  feishuPairingRecords FeishuPairingRecord[]

  @@index([status])
  @@index([hostname])
  @@index([createdById])
  @@index([personaTemplateId])
  @@index([avatarFileId])
  @@index([isDeleted])
  @@index([healthStatus])
  @@index([botType])
  @@map("b_bot")
}

/// ProviderKey - AI 提供商 API 密钥
/// 存储加密的 API 密钥，支持多提供商和标签路由
/// ProviderKey - API 密钥配置
/// 存储用户配置的各类 AI 服务商 API 密钥
/// 支持 OpenAI、Anthropic、Google、DeepSeek 等主流服务商，以及自定义服务商
model ProviderKey {
  /// 主键 UUID
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 服务商标识：openai, anthropic, google, venice, deepseek, groq, custom 等
  vendor          String  @db.VarChar(50)
  /// API 协议类型：openai, anthropic, gemini, azure-openai, aws-bedrock, vertexai, ollama, new-api, gateway 等
  /// 用于确定 API 调用方式，custom 服务商必填
  apiType         String? @map("api_type") @db.VarChar(50)
  /// 加密存储的 API 密钥（AES-256-GCM 加密）
  secretEncrypted Bytes   @map("secret_encrypted")
  /// 密钥名称（必填），用于用户识别不同密钥，同一用户下唯一
  label           String  @db.VarChar(255)
  /// 路由标签，用于在多密钥场景下进行流量分配
  tag             String? @db.VarChar(100)
  /// 自定义 API 地址，用于私有部署或代理服务
  baseUrl         String? @map("base_url") @db.VarChar(500)
  /// 额外配置（JSON），存储 provider 特定的参数，如 MiniMax 的 groupId
  metadata        Json?   @map("metadata") @db.JsonB
  /// 创建者用户 ID
  createdById     String  @map("created_by_id") @db.Uuid

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  createdBy          UserInfo            @relation(fields: [createdById], references: [id])
  usageLogs          BotUsageLog[]
  proxyTokens        ProxyToken[]
  modelAvailability  ModelAvailability[]

  @@unique([createdById, label], name: "provider_key_user_label_unique")
  @@index([vendor])
  @@index([apiType])
  @@index([tag])
  @@index([createdById])
  @@index([isDeleted])
  @@map("b_provider_key")
}

/// BotModel - Bot 与模型的关联表
/// 存储 Bot 可以使用的模型列表
/// 普通用户只需要关心模型，不需要了解 Provider 概念
model BotModel {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId     String   @map("bot_id") @db.Uuid
  /// 模型标识符，如 "gpt-4o", "claude-sonnet-4-20250514"
  modelId   String   @map("model_id") @db.VarChar(100)
  /// 是否启用该模型
  isEnabled Boolean  @default(true) @map("is_enabled")
  /// 是否为主模型（Bot 默认使用的模型）
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, modelId])
  @@index([botId])
  @@index([modelId])
  @@map("b_bot_model")
}

/// 模型类型枚举
/// 用于分类模型的能力类型（与 provider.schema.ts 中的 ModelTypeSchema 保持一致）
enum ModelType {
  llm            @map("llm")            // 大语言模型
  text_embedding @map("text-embedding") // 文本嵌入
  speech2text    @map("speech2text")    // 语音转文字
  tts            @map("tts")            // 文字转语音
  moderation     @map("moderation")     // 内容审核
  rerank         @map("rerank")         // 重排序
  image          @map("image")          // 图像生成
  video          @map("video")          // 视频生成

  @@map("model_type")
}

/// ModelAvailability - 模型可用性缓存表
/// 缓存 API Key 验证结果，避免频繁调用外部 API
/// vendor 信息从关联的 ProviderKey 中获取，避免数据冗余
model ModelAvailability {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 模型标识符，如 "gpt-4o", "claude-sonnet-4-20250514"（反范式化冗余，与 ModelCatalog.model 一致）
  model          String    @db.VarChar(100)
  /// 关联的 Provider Key（vendor 信息从这里获取）
  providerKeyId  String    @map("provider_key_id") @db.Uuid
  /// 关联的 ModelCatalog ID（必填，模型发现时自动创建 catalog）
  modelCatalogId String    @map("model_catalog_id") @db.Uuid
  /// 模型类型（llm, image, video, tts, embedding 等）
  modelType      ModelType @default(llm) @map("model_type")
  /// 模型是否可用（API Key 验证通过）
  isAvailable    Boolean   @default(false) @map("is_available")
  /// 最后验证时间
  lastVerifiedAt DateTime  @map("last_verified_at") @db.Timestamptz(6)
  /// 验证失败时的错误信息
  errorMessage   String?   @map("error_message") @db.Text

  // ============ Vendor 级别特有配置 ============
  /// 该 vendor 实例的优先级（用于同模型多 vendor 时的选择）
  vendorPriority Int @default(0) @map("vendor_priority")
  /// 该 vendor 实例的健康评分（基于历史成功率动态计算）
  healthScore    Int @default(100) @map("health_score")

  // ============ 协议适配配置（双层模型体系）============
  /// 模型支持的协议类型列表（从 ModelCatalog 同步）
  /// 如 ["openai", "anthropic"] 表示同时支持 OpenAI 和 Anthropic 协议
  supportedApiTypes String[] @default(["openai"]) @map("supported_api_types")
  /// 用户优先选择的协议类型（可选，默认使用 Provider 默认协议）
  /// 用于第二层（研究 Agent）模型选择使用 Anthropic 协议
  preferredApiType  String?  @map("preferred_api_type") @db.VarChar(50)

  // ============ 协议级别 BaseUrl 配置 ============
  /// 按协议类型配置的 BaseUrl
  /// JSON 格式：{ "openai": "https://...", "anthropic": "https://..." }
  /// 未配置的协议使用 ProviderKey.baseUrl
  apiTypeBaseUrls   Json?    @map("api_type_base_urls") @db.JsonB

  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  providerKey    ProviderKey  @relation(fields: [providerKeyId], references: [id], onDelete: Cascade)
  modelCatalog   ModelCatalog @relation(fields: [modelCatalogId], references: [id], onDelete: Restrict)

  @@unique([providerKeyId, model])
  @@index([model])
  @@index([modelCatalogId])
  @@index([modelType])
  @@index([isAvailable])
  @@index([preferredApiType])
  @@map("b_model_availability")
}

/// ModelCapabilityTag - 模型与能力标签的关联表
/// 存储模型（非 vendor 实例）与能力标签的多对多关系，支持匹配来源追踪
model ModelCapabilityTag {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 关联的 ModelCatalog ID（模型级别）
  modelCatalogId  String   @map("model_catalog_id") @db.Uuid
  /// 关联的 CapabilityTag ID
  capabilityTagId String   @map("capability_tag_id") @db.Uuid
  /// 匹配来源：pattern (模式匹配), feature (特性匹配), scenario (场景匹配), manual (手动)
  matchSource     String   @default("pattern") @map("match_source") @db.VarChar(20)
  /// 匹配置信度 (0-100)
  confidence      Int      @default(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  modelCatalog  ModelCatalog  @relation(fields: [modelCatalogId], references: [id], onDelete: Cascade)
  capabilityTag CapabilityTag @relation(fields: [capabilityTagId], references: [id], onDelete: Cascade)

  @@unique([modelCatalogId, capabilityTagId])
  @@index([modelCatalogId])
  @@index([capabilityTagId])
  @@index([matchSource])
  @@map("b_model_capability_tag")
}

/// BotUsageLog - Bot API 使用日志
/// 记录每次 API 调用的使用情况
model BotUsageLog {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId          String   @map("bot_id") @db.Uuid
  vendor         String   @db.VarChar(50)
  providerKeyId  String?  @map("provider_key_id") @db.Uuid
  statusCode     Int?     @map("status_code")
  requestTokens  Int?     @map("request_tokens")
  responseTokens Int?     @map("response_tokens")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 基础字段 - 用于精细化用量分析
  model        String? @db.VarChar(100) // AI 模型名称
  endpoint     String? @db.VarChar(255) // API 端点路径
  durationMs   Int?    @map("duration_ms") // 请求耗时（毫秒）
  errorMessage String? @map("error_message") @db.Text // 错误信息

  // ============ 混合架构扩展字段 ============
  // 原生功能使用追踪
  /// Extended Thinking tokens
  thinkingTokens   Int? @map("thinking_tokens")
  /// Cache Control 读取 tokens
  cacheReadTokens  Int? @map("cache_read_tokens")
  /// Cache Control 写入 tokens
  cacheWriteTokens Int? @map("cache_write_tokens")

  /// 协议类型：openai-compatible | anthropic-native | gemini-native
  protocolType String? @map("protocol_type") @db.VarChar(50)

  // 成本追踪（美元）
  /// 输入成本
  inputCost    Decimal? @map("input_cost") @db.Decimal(10, 6)
  /// 输出成本
  outputCost   Decimal? @map("output_cost") @db.Decimal(10, 6)
  /// 思考成本
  thinkingCost Decimal? @map("thinking_cost") @db.Decimal(10, 6)
  /// 缓存成本
  cacheCost    Decimal? @map("cache_cost") @db.Decimal(10, 6)
  /// 总成本
  totalCost    Decimal? @map("total_cost") @db.Decimal(10, 6)

  // Fallback 追踪
  /// 是否使用了 Fallback
  fallbackUsed  Boolean? @map("fallback_used")
  /// Fallback 级别（0=主模型，1=第一备用，以此类推）
  fallbackLevel Int?     @map("fallback_level")
  /// 原始请求模型
  originalModel String?  @map("original_model") @db.VarChar(100)

  bot         Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  providerKey ProviderKey? @relation(fields: [providerKeyId], references: [id], onDelete: SetNull)

  @@index([botId])
  @@index([createdAt])
  @@index([vendor])
  @@index([botId, createdAt]) // 复合索引：按 Bot 查询时间范围
  @@index([botId, vendor, createdAt]) // 复合索引：按 Bot+Vendor 查询
  @@index([model]) // 按模型查询
  @@index([protocolType]) // 按协议类型查询
  @@index([fallbackUsed]) // 按 Fallback 使用情况查询
  @@map("b_usage_log")
}

// ============================================================================
// Zero-Trust Mode - Proxy Token System
// ============================================================================

/// ProxyToken - Zero-Trust 模式的代理令牌
/// Bot 容器使用此令牌通过 Proxy 访问 AI API，而不直接持有 API Key
/// 核心安全原则：Bot 容器永远不持有真实的 API Key
model ProxyToken {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 关联的 Bot ID（一对一关系）
  botId        String    @unique @map("bot_id") @db.Uuid
  /// Token 的 SHA-256 哈希值（永不存储原始 Token）
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  /// AI 服务商标识（openai, anthropic, google 等）
  vendor       String    @db.VarChar(50)
  /// 关联的 ProviderKey ID
  keyId        String    @map("key_id") @db.Uuid
  /// 访问控制标签
  tags         String[]
  /// Token 过期时间（可选）
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  /// Token 撤销时间（null 表示有效）
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// 最后使用时间
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  /// 请求计数
  requestCount Int       @default(0) @map("request_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  bot         Bot         @relation(fields: [botId], references: [id], onDelete: Cascade)
  providerKey ProviderKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([botId])
  @@index([keyId])
  @@index([vendor])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("b_proxy_token")
}

/// User Message System
/// 用户消息系统 - 支持系统通知、用户间消息等
model Message {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type      String    @db.VarChar(50) // SYSTEM, USER, NOTIFICATION, MILESTONE, ACHIEVEMENT
  title     String?   @db.VarChar(255)
  content   Json // 消息内容（支持富文本、多语言）
  senderId  String?   @map("sender_id") @db.Uuid // null for system messages
  metadata  Json? // 额外元数据（如关联的问题ID、徽章ID等）
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  sender     UserInfo?          @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  recipients MessageRecipient[]

  @@index([type])
  @@index([senderId])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("message")
}

/// Message Recipient - 消息接收记录
/// 记录每个用户接收到的消息及其阅读状态
model MessageRecipient {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  messageId String    @map("message_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  message Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    UserInfo @relation("ReceivedMessages", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, isRead])
  @@index([messageId])
  @@index([isDeleted])
  @@index([userId, isRead, isDeleted]) // Composite index for unread message count queries
  @@map("message_recipient")
}

// ============================================================================
// Operation Log System - 操作日志系统
// ============================================================================

enum OperateType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  START
  STOP
  EXPORT
  IMPORT

  @@map("operate_type")
}

enum OperateTarget {
  BOT
  PROVIDER_KEY
  USER
  PERSONA_TEMPLATE
  SYSTEM

  @@map("operate_target")
}

/// OperateLog - 操作日志
/// 记录用户的操作行为，用于审计和追踪
model OperateLog {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  operateType OperateType   @map("operate_type")
  target      OperateTarget
  targetId    String?       @map("target_id") @db.Uuid
  targetName  String?       @map("target_name") @db.VarChar(255)
  detail      Json?
  ipAddress   String?       @map("ip_address") @db.VarChar(45)
  userAgent   String?       @map("user_agent") @db.VarChar(500)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user UserInfo @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([operateType])
  @@index([target])
  @@index([targetId])
  @@index([createdAt(sort: Desc)])
  @@map("operate_log")
}

// ============================================================================
// Channel Definition System - 渠道定义系统
// ============================================================================

/// ChannelDefinition - 渠道定义
/// 存储各种消息渠道的配置信息，包括所需的凭证字段
model ChannelDefinition {
  id               String   @id @db.VarChar(50) // e.g., "feishu", "telegram", "discord"
  label            String   @db.VarChar(100) // Display name
  icon             String   @db.VarChar(10) // Emoji or short icon code
  popular          Boolean  @default(false) // Whether to show in popular section (default/fallback)
  popularLocales   String[] @default([]) @map("popular_locales") // Locales where this channel is popular, e.g., ["zh-CN", "en"]
  tokenHint        String   @map("token_hint") @db.VarChar(500) // Help text for token
  tokenPlaceholder String   @map("token_placeholder") @db.VarChar(255) // Placeholder text
  helpUrl          String?  @map("help_url") @db.VarChar(500) // Documentation URL
  helpText         String?  @map("help_text") @db.VarChar(255) // Help link text
  sortOrder        Int      @default(0) @map("sort_order") // Display order

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  credentialFields ChannelCredentialField[]

  @@index([popular])
  @@index([sortOrder])
  @@index([isDeleted])
  @@map("b_channel_definition")
}

/// ChannelCredentialField - 渠道凭证字段
/// 定义每个渠道所需的凭证字段配置
model ChannelCredentialField {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  channelId   String  @map("channel_id") @db.VarChar(50)
  key         String  @db.VarChar(50) // Field key, e.g., "appId", "appSecret"
  label       String  @db.VarChar(100) // Display label
  placeholder String  @db.VarChar(255) // Placeholder text
  fieldType   String  @default("text") @map("field_type") @db.VarChar(20) // "text" or "password"
  required    Boolean @default(true) // Whether field is required
  sortOrder   Int     @default(0) @map("sort_order") // Display order within channel

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  channel ChannelDefinition @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, key])
  @@index([channelId])
  @@index([sortOrder])
  @@index([isDeleted])
  @@map("b_channel_credential_field")
}

// ============================================================================
// Plugin System - 插件系统
// ============================================================================

/// 插件分类
enum PluginCategory {
  BROWSER // 浏览器自动化
  FILESYSTEM // 文件系统
  DATABASE // 数据库
  API // API 集成
  COMMUNICATION // 通讯工具
  DEVELOPMENT // 开发工具
  CUSTOM // 自定义

  @@map("plugin_category")
}

/// Plugin - 插件定义
/// 存储插件的元数据和配置模板
model Plugin {
  id            String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String         @db.VarChar(100)
  slug          String         @unique @db.VarChar(100)
  description   String?        @db.Text
  version       String         @db.VarChar(20)
  author        String?        @db.VarChar(100)
  category      PluginCategory
  region        String         @default("global") @db.VarChar(20) // global, cn, en
  configSchema  Json?          @map("config_schema") // JSON Schema for plugin config
  defaultConfig Json?          @map("default_config") // Default configuration
  mcpConfig     Json?          @map("mcp_config") // MCP server configuration
  isOfficial    Boolean        @default(false) @map("is_official")
  isEnabled     Boolean        @default(true) @map("is_enabled")
  downloadUrl   String?        @map("download_url") @db.VarChar(500)
  iconEmoji     String?        @map("icon_emoji") @db.VarChar(10)
  iconUrl       String?        @map("icon_url") @db.VarChar(500)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  installations BotPlugin[]

  @@index([category])
  @@index([region])
  @@index([isOfficial])
  @@index([isEnabled])
  @@index([isDeleted])
  @@map("b_plugin")
}

/// BotPlugin - Bot 与 Plugin 的关联表
/// 记录 Bot 安装的插件及其配置
model BotPlugin {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId     String   @map("bot_id") @db.Uuid
  pluginId  String   @map("plugin_id") @db.Uuid
  config    Json? // Plugin instance configuration
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bot    Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)
  plugin Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([botId, pluginId])
  @@index([botId])
  @@index([pluginId])
  @@index([isEnabled])
  @@map("b_bot_plugin")
}

/// SkillType - 技能类型/分类
/// 用于对技能进行分类管理，支持中英文名称
model SkillType {
  id            String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 类型标识（如 coding-agents, git-github）
  slug          String  @unique @db.VarChar(100)
  /// 英文名称（如 Coding Agents & IDEs）
  name          String  @db.VarChar(200)
  /// 中文名称
  nameZh        String? @map("name_zh") @db.VarChar(200)
  /// 英文描述
  description   String? @db.Text
  /// 中文描述
  descriptionZh String? @map("description_zh") @db.Text
  /// 图标（emoji 或图标名称）
  icon          String? @db.VarChar(50)
  /// 排序权重（越小越靠前）
  sortOrder     Int     @default(0) @map("sort_order")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  skills Skill[]

  @@index([slug])
  @@index([sortOrder])
  @@index([isDeleted])
  @@map("b_skill_type")
}

/// Skill - 自定义技能定义
/// 用户可以创建自定义技能供 Bot 使用
/// 支持系统预设、用户自定义和外部同步（如 OpenClaw）
model Skill {
  id            String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String  @db.VarChar(100)
  /// 中文名称（翻译自 name）
  nameZh        String? @map("name_zh") @db.VarChar(200)
  slug          String  @db.VarChar(100)
  /// 英文描述（原始描述）
  description   String? @db.Text
  /// 中文描述（翻译自 description）
  descriptionZh String? @map("description_zh") @db.Text
  version       String  @default("1.0.0") @db.VarChar(20)
  /// 最新可用版本（来自 _meta.json）
  latestVersion String? @map("latest_version") @db.VarChar(20)

  // 技能类型关联
  skillTypeId String?    @map("skill_type_id") @db.Uuid
  skillType   SkillType? @relation(fields: [skillTypeId], references: [id], onDelete: SetNull)

  // 技能定义 (JSON)
  // 对于 tool 类型: { name, description, inputSchema, handler }
  // 对于 prompt 类型: { template, variables }
  // 对于 workflow 类型: { steps, triggers }
  definition Json @db.JsonB

  // 示例用法
  examples Json? @db.JsonB

  // 是否为系统预设
  isSystem  Boolean @default(false) @map("is_system")
  isEnabled Boolean @default(true) @map("is_enabled")

  // 创建者
  createdById String? @map("created_by_id") @db.Uuid

  // ============ 外部来源字段（用于同步 OpenClaw 等外部技能库）============
  /// 外部来源标识（如 openclaw, clawhub）
  source       String?   @db.VarChar(50)
  /// 外部来源 URL（如 GitHub 仓库链接）
  sourceUrl    String?   @map("source_url") @db.VarChar(500)
  /// 技能作者（外部来源的作者）
  author       String?   @db.VarChar(100)
  /// 最后同步时间（元数据同步）
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)

  // ============ 预同步文件目录（用于加速安装）============
  /// 完整的技能文件目录（从 GitHub 预同步）
  /// 格式: [{ relativePath: string, content: string, size: number }]
  files        Json?     @db.JsonB
  /// 文件目录同步时间
  filesSyncedAt DateTime? @map("files_synced_at") @db.Timestamptz(6)
  /// 文件数量
  fileCount     Int?      @map("file_count")
  /// 是否包含初始化脚本 (scripts/init.sh)
  hasInitScript Boolean   @default(false) @map("has_init_script")
  /// 是否包含参考文档 (references/)
  hasReferences Boolean   @default(false) @map("has_references")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  installations BotSkill[]

  @@unique([slug, createdById])
  @@unique([source, slug], name: "b_skill_source_slug_key")
  @@index([skillTypeId])
  @@index([isSystem])
  @@index([isEnabled])
  @@index([createdById])
  @@index([isDeleted])
  @@index([source])
  @@index([lastSyncedAt])
  @@map("b_skill")
}

/// BotSkill - Bot 与 Skill 的关联表
/// 记录 Bot 安装的技能及其配置
model BotSkill {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId     String   @map("bot_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  config    Json? // Skill instance configuration overrides
  /// 安装时的技能版本
  installedVersion String? @map("installed_version") @db.VarChar(20)
  /// 安装的文件数量
  fileCount        Int?    @map("file_count")
  /// 是否执行了初始化脚本
  scriptExecuted   Boolean @default(false) @map("script_executed")
  /// 是否包含参考文档
  hasReferences    Boolean @default(false) @map("has_references")
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bot   Bot   @relation(fields: [botId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([botId, skillId])
  @@index([botId])
  @@index([skillId])
  @@index([isEnabled])
  @@map("b_bot_skill")
}

// ============================================================================
// Bot Channel System - Bot 渠道系统
// ============================================================================

/// 渠道连接状态
enum ChannelConnectionStatus {
  DISCONNECTED // 未连接
  CONNECTING // 连接中
  CONNECTED // 已连接
  ERROR // 连接错误

  @@map("channel_connection_status")
}

// ============================================================================
// Model Pricing System - AI 模型定价系统
// ============================================================================

/// ModelPricing - AI 模型定价与能力目录
/// 存储各 AI 模型的定价信息、能力评分和特性支持，用于成本估算和智能路由
/// 价格单位：美元/百万 tokens
/// ModelCatalog - 模型目录（全局模型注册中心）
/// 以 model 为唯一标识，存储模型身份、定价、能力评分、特性支持等信息
/// 所有路由配置（能力标签、Fallback、复杂度路由）均引用此表
/// 原表名 b_model_pricing，重构后升级为 b_model_catalog
model ModelCatalog {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 模型标识符（全局唯一），如 "gpt-4o", "claude-sonnet-4-20250514"
  model       String  @unique @db.VarChar(100)
  /// 原始供应商标识（openai, anthropic, google, deepseek 等）
  vendor      String  @db.VarChar(50)
  /// 模型显示名称
  displayName String? @map("display_name") @db.VarChar(255)
  /// 模型描述
  description String? @db.Text

  // ============ 定价信息（美元/百万 tokens）============
  /// 输入 token 价格
  inputPrice      Decimal  @map("input_price") @db.Decimal(10, 6)
  /// 输出 token 价格
  outputPrice     Decimal  @map("output_price") @db.Decimal(10, 6)
  /// 缓存读取价格（Anthropic Cache Control）
  cacheReadPrice  Decimal? @map("cache_read_price") @db.Decimal(10, 6)
  /// 缓存写入价格（Anthropic Cache Control）
  cacheWritePrice Decimal? @map("cache_write_price") @db.Decimal(10, 6)
  /// 思考 token 价格（Anthropic Extended Thinking）
  thinkingPrice   Decimal? @map("thinking_price") @db.Decimal(10, 6)

  // ============ 能力评分（0-100）============
  /// 推理能力评分
  reasoningScore  Int @default(50) @map("reasoning_score")
  /// 编码能力评分
  codingScore     Int @default(50) @map("coding_score")
  /// 创造力评分
  creativityScore Int @default(50) @map("creativity_score")
  /// 响应速度评分
  speedScore      Int @default(50) @map("speed_score")
  /// 上下文长度（K tokens）
  contextLength   Int @default(128) @map("context_length")

  // ============ 特性支持 ============
  /// 是否支持 Extended Thinking（Anthropic）
  supportsExtendedThinking Boolean @default(false) @map("supports_extended_thinking")
  /// 是否支持 Cache Control（Anthropic）
  supportsCacheControl     Boolean @default(false) @map("supports_cache_control")
  /// 是否支持视觉/多模态
  supportsVision           Boolean @default(false) @map("supports_vision")
  /// 是否支持 Function Calling
  supportsFunctionCalling  Boolean @default(true) @map("supports_function_calling")
  /// 是否支持流式响应
  supportsStreaming        Boolean @default(true) @map("supports_streaming")

  // ============ 推荐场景 ============
  /// 推荐使用场景（JSON 数组）
  /// 如 ["deep-reasoning", "coding", "general-purpose"]
  recommendedScenarios Json? @map("recommended_scenarios") @db.JsonB

  // ============ 协议适配配置（双层模型体系）============
  /// 该模型支持的 API 协议类型列表
  /// 如 ["openai", "anthropic"] 表示同时支持 OpenAI 和 Anthropic 协议
  /// 用于前端显示协议选择器和后端验证
  supportedApiTypes  String[] @default(["openai"]) @map("supported_api_types")
  /// Anthropic 协议模型标识符（如果与 openai 不同）
  /// 某些模型在 Anthropic 协议下的名称可能与 OpenAI 不同
  anthropicModelId   String?  @map("anthropic_model_id") @db.VarChar(100)
  /// 是否推荐使用 Anthropic 协议
  /// 用于第二层（研究 Agent）模型，充分利用 Extended Thinking
  recommendAnthropic Boolean  @default(false) @map("recommend_anthropic")
  /// 推荐使用 Anthropic 协议的原因
  /// 如 "更好的 Extended Thinking 和流式输出支持"
  recommendReason    String?  @map("recommend_reason") @db.VarChar(500)
  /// 模型所属层级：production（第一层）、research（第二层）、both（两者皆可）
  modelLayer         String   @default("production") @map("model_layer") @db.VarChar(20)

  // ============ 数据来源追踪 ============
  /// 数据来源：manual (手动), api (API同步), import (导入)
  dataSource String  @default("manual") @map("data_source") @db.VarChar(20)
  /// 来源 URL（如果从外部 API 同步）
  sourceUrl  String? @map("source_url") @db.VarChar(500)

  // ============ 状态 ============
  /// 是否启用
  isEnabled       Boolean   @default(true) @map("is_enabled")
  /// 是否已弃用
  isDeprecated    Boolean   @default(false) @map("is_deprecated")
  /// 弃用日期
  deprecationDate DateTime? @map("deprecation_date") @db.Timestamptz(6)
  /// 价格更新时间
  priceUpdatedAt  DateTime  @default(now()) @map("price_updated_at") @db.Timestamptz(6)
  /// 备注
  notes           String?   @db.Text
  /// 其他扩展元数据
  metadata        Json?     @db.JsonB

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ============ 关联关系 ============
  /// 该模型在各 vendor 的可用性记录
  availabilities            ModelAvailability[]
  /// 模型能力标签（模型级）
  capabilityTags            ModelCapabilityTag[]
  /// Fallback 链引用
  fallbackChainModels       FallbackChainModel[]
  /// 复杂度路由引用
  complexityRoutingMappings ComplexityRoutingModelMapping[]

  @@index([vendor])
  @@index([isEnabled])
  @@index([isDeprecated])
  @@index([isDeleted])
  @@index([supportsExtendedThinking])
  @@index([supportsCacheControl])
  @@index([recommendAnthropic])
  @@index([modelLayer])
  @@map("b_model_catalog")
}

// ============================================================================
// Model Routing System - 模型路由系统
// ============================================================================

/// 路由类型枚举
enum ModelRoutingType {
  FUNCTION_ROUTE // 功能路由：根据消息内容选择模型
  LOAD_BALANCE // 负载均衡：多模型分流
  FAILOVER // 故障转移：主备切换

  @@map("model_routing_type")
}

/// BotModelRouting - Bot 模型路由配置
/// 存储 Bot 的模型路由规则，支持功能路由、负载均衡、故障转移
model BotModelRouting {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId       String           @map("bot_id") @db.Uuid
  /// 路由类型
  routingType ModelRoutingType @map("routing_type")
  /// 路由名称（用于标识）
  name        String           @db.VarChar(100)
  /// 路由配置 (JSON)
  /// 功能路由: { rules: [...], defaultTarget: {...} }
  /// 负载均衡: { strategy: "round_robin"|"weighted"|"least_latency", targets: [...] }
  /// 故障转移: { primary: {...}, fallbackChain: [...], retry: {...} }
  config      Json             @db.JsonB
  /// 优先级（数字越小优先级越高）
  priority    Int              @default(100)
  /// 是否启用
  isEnabled   Boolean          @default(true) @map("is_enabled")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([routingType])
  @@index([priority])
  @@index([isEnabled])
  @@index([isDeleted])
  @@map("b_bot_model_routing")
}

/// BotChannel - Bot 渠道配置
/// 存储 Bot 的渠道连接配置，包括加密的凭证
/// 一个 Bot 可以连接多个渠道（如同时连接飞书和 Telegram）
model BotChannel {
  id                   String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId                String                  @map("bot_id") @db.Uuid
  channelType          String                  @map("channel_type") @db.VarChar(50) // feishu, telegram, discord, etc.
  name                 String                  @db.VarChar(255) // 渠道名称，用于区分同类型多个渠道
  credentialsEncrypted Bytes                   @map("credentials_encrypted") // AES-256-GCM 加密的凭证 JSON
  config               Json? // 渠道特定配置（如 requireMention, replyInThread 等）
  isEnabled            Boolean                 @default(true) @map("is_enabled")
  connectionStatus     ChannelConnectionStatus @default(DISCONNECTED) @map("connection_status")
  lastConnectedAt      DateTime?               @map("last_connected_at") @db.Timestamptz(6)
  lastError            String?                 @map("last_error") @db.Text

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  bot    Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)
  feishuPairingRecords FeishuPairingRecord[]

  @@unique([botId, channelType, name])
  @@index([botId])
  @@index([channelType])
  @@index([isEnabled])
  @@index([connectionStatus])
  @@index([isDeleted])
  @@map("b_bot_channel")
}

// ============================================================================
// Channel Pairing System - 渠道配对系统
// ============================================================================

/// PairingStatus - 配对状态
enum PairingStatus {
  PENDING   // 待处理
  APPROVED  // 已批准
  REJECTED  // 已拒绝
  EXPIRED   // 已过期

  @@map("pairing_status")
}

/// FeishuPairingRecord - 飞书配对记录
/// 持久化存储飞书用户的配对信息和用户基本信息
/// 启动时与文件系统 pairing.json 同步，数据库为最高优先级
model FeishuPairingRecord {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  // ============ 关联 ============
  botId      String @map("bot_id") @db.Uuid
  botChannelId String @map("bot_channel_id") @db.Uuid

  // ============ 配对信息 ============
  /// 配对码（6-8位大写字母数字）
  code          String @db.VarChar(8)
  /// 飞书用户 Open ID
  feishuOpenId  String @map("feishu_open_id") @db.VarChar(100)
  /// 配对状态
  status        PairingStatus @default(PENDING)

  // ============ 飞书用户信息 ============
  /// 用户名称
  userName      String? @map("user_name") @db.VarChar(255)
  /// 用户英文名
  userNameEn    String? @map("user_name_en") @db.VarChar(255)
  /// 用户头像 URL
  userAvatarUrl String? @map("user_avatar_url") @db.VarChar(500)
  /// 用户邮箱
  userEmail     String? @map("user_email") @db.VarChar(255)
  /// 用户手机号
  userMobile    String? @map("user_mobile") @db.VarChar(50)
  /// 用户部门 ID
  userDepartmentId   String? @map("user_department_id") @db.VarChar(100)
  /// 用户部门名称
  userDepartmentName String? @map("user_department_name") @db.VarChar(255)
  /// 原始用户信息（JSON，存储完整的飞书用户信息）
  userInfoRaw   Json?  @map("user_info_raw") @db.JsonB

  // ============ 时间戳 ============
  /// 配对请求创建时间
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  /// 批准时间
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  /// 批准人 ID
  approvedById  String?   @map("approved_by_id") @db.Uuid
  /// 拒绝时间
  rejectedAt    DateTime? @map("rejected_at") @db.Timestamptz(6)
  /// 拒绝人 ID
  rejectedById  String?   @map("rejected_by_id") @db.Uuid
  /// 最后从飞书同步用户信息的时间
  lastSyncedAt  DateTime? @map("last_synced_at") @db.Timestamptz(6)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  bot        Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  botChannel BotChannel @relation(fields: [botChannelId], references: [id], onDelete: Cascade)

  @@unique([botId, code])
  @@unique([botId, feishuOpenId])
  @@index([botId])
  @@index([botChannelId])
  @@index([code])
  @@index([feishuOpenId])
  @@index([status])
  @@index([isDeleted])
  @@map("b_feishu_pairing_record")
}

// ============================================================================
// Hybrid Architecture - Routing Configuration System
// 混合架构 - 路由配置系统
// ============================================================================

/// CapabilityTag - 能力标签
/// 定义路由能力标签及其要求，用于智能路由决策
model CapabilityTag {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 标签标识（如 deep-reasoning, cost-optimized, web-search）
  tagId       String  @unique @map("tag_id") @db.VarChar(50)
  /// 显示名称
  name        String  @db.VarChar(100)
  /// 标签描述
  description String? @db.Text

  /// 分类：reasoning | search | code | vision | audio | cost | context
  category String @db.VarChar(50)

  /// 路由优先级（数值越高优先级越高）
  priority Int @default(50)

  // ============ 路由要求 ============
  /// 要求的协议类型：openai-compatible | anthropic-native | null
  requiredProtocol String? @map("required_protocol") @db.VarChar(50)
  /// 要求的 Skills（JSON 数组）如 ["web_search", "code_runner"]
  requiredSkills   Json?   @map("required_skills") @db.JsonB
  /// 要求的模型列表（JSON 数组）如 ["claude-sonnet-4-*", "gpt-4o"]
  requiredModels   Json?   @map("required_models") @db.JsonB

  // ============ 特性要求 ============
  /// 是否要求 Extended Thinking
  requiresExtendedThinking Boolean @default(false) @map("requires_extended_thinking")
  /// 是否要求 Cache Control
  requiresCacheControl     Boolean @default(false) @map("requires_cache_control")
  /// 是否要求视觉能力
  requiresVision           Boolean @default(false) @map("requires_vision")

  /// 单次请求最大成本约束（美元）
  maxCostPerMToken Decimal? @map("max_cost_per_m_token") @db.Decimal(10, 6)

  // ============ 状态 ============
  /// 是否启用
  isActive  Boolean @default(true) @map("is_active")
  /// 是否为内置标签
  isBuiltin Boolean @default(false) @map("is_builtin")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  modelCapabilityTags ModelCapabilityTag[]

  @@index([category])
  @@index([isActive])
  @@index([isBuiltin])
  @@index([isDeleted])
  @@map("b_capability_tag")
}

/// FallbackChain - Fallback 链配置
/// 定义模型降级策略，支持多模型故障转移
model FallbackChain {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 链标识（如 default, deep-reasoning, cost-optimized）
  chainId     String  @unique @map("chain_id") @db.VarChar(50)
  /// 显示名称
  name        String  @db.VarChar(100)
  /// 链描述
  description String? @db.Text

  /// @deprecated 旧的 JSON 模型链配置，迁移到 FallbackChainModel 关联表后移除
  /// [{ vendor: "anthropic", model: "claude-sonnet-4", protocol: "anthropic-native", features: {...} }]
  models Json? @db.JsonB

  // 新：通过关联表引用实际可用模型
  chainModels FallbackChainModel[]

  // ============ 触发条件 ============
  /// 触发 Fallback 的 HTTP 状态码（JSON 数组）
  triggerStatusCodes Json @default("[429, 500, 502, 503, 504]") @map("trigger_status_codes") @db.JsonB
  /// 触发 Fallback 的错误类型（JSON 数组）
  triggerErrorTypes  Json @default("[\"rate_limit\", \"overloaded\", \"timeout\"]") @map("trigger_error_types") @db.JsonB
  /// 触发 Fallback 的超时时间（毫秒）
  triggerTimeoutMs   Int  @default(60000) @map("trigger_timeout_ms")

  // ============ 行为配置 ============
  /// 最大重试次数
  maxRetries       Int     @default(3) @map("max_retries")
  /// 重试间隔（毫秒）
  retryDelayMs     Int     @default(2000) @map("retry_delay_ms")
  /// 是否保持协议一致（降级时是否允许切换协议）
  preserveProtocol Boolean @default(false) @map("preserve_protocol")

  // ============ 状态 ============
  /// 是否启用
  isActive  Boolean @default(true) @map("is_active")
  /// 是否为内置链
  isBuiltin Boolean @default(false) @map("is_builtin")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([isActive])
  @@index([isBuiltin])
  @@index([isDeleted])
  @@map("b_fallback_chain")
}

/// CostStrategy - 成本策略配置
/// 定义成本优化策略，用于模型选择决策
model CostStrategy {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 策略标识（如 lowest-cost, best-value, performance-first, balanced）
  strategyId  String  @unique @map("strategy_id") @db.VarChar(50)
  /// 显示名称
  name        String  @db.VarChar(100)
  /// 策略描述
  description String? @db.Text

  // ============ 优化权重（0-1，总和为 1）============
  /// 成本权重
  costWeight        Decimal @default(0.5) @map("cost_weight") @db.Decimal(3, 2)
  /// 性能权重
  performanceWeight Decimal @default(0.3) @map("performance_weight") @db.Decimal(3, 2)
  /// 能力权重
  capabilityWeight  Decimal @default(0.2) @map("capability_weight") @db.Decimal(3, 2)

  // ============ 约束条件 ============
  /// 单次请求最大成本（美元）
  maxCostPerRequest  Decimal? @map("max_cost_per_request") @db.Decimal(10, 6)
  /// 最大延迟（毫秒）
  maxLatencyMs       Int?     @map("max_latency_ms")
  /// 最低能力评分
  minCapabilityScore Int?     @map("min_capability_score")

  /// 场景权重配置（JSON）
  /// { "reasoning": 0.5, "coding": 0.3, "creativity": 0.2, "speed": 0.5 }
  scenarioWeights Json? @map("scenario_weights") @db.JsonB

  // ============ 状态 ============
  /// 是否启用
  isActive  Boolean @default(true) @map("is_active")
  /// 是否为内置策略
  isBuiltin Boolean @default(false) @map("is_builtin")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([isActive])
  @@index([isBuiltin])
  @@index([isDeleted])
  @@map("b_cost_strategy")
}

/// BotRoutingConfig - Bot 路由配置
/// 存储 Bot 的智能路由、Fallback 和成本控制配置
model BotRoutingConfig {
  id    String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId String @unique @map("bot_id") @db.Uuid

  // ============ 路由配置 ============
  /// 是否启用智能路由
  routingEnabled Boolean @default(true) @map("routing_enabled")
  /// 路由模式：auto | manual | cost-optimized
  routingMode    String  @default("auto") @map("routing_mode") @db.VarChar(20)

  // ============ Fallback 配置 ============
  /// 是否启用 Fallback
  fallbackEnabled Boolean @default(true) @map("fallback_enabled")
  /// 默认 Fallback 链 ID
  fallbackChainId String? @map("fallback_chain_id") @db.VarChar(50)

  // ============ 成本控制配置 ============
  /// 是否启用成本控制
  costControlEnabled Boolean  @default(false) @map("cost_control_enabled")
  /// 成本策略 ID
  costStrategyId     String?  @map("cost_strategy_id") @db.VarChar(50)
  /// 每日预算（美元）
  dailyBudget        Decimal? @map("daily_budget") @db.Decimal(10, 2)
  /// 每月预算（美元）
  monthlyBudget      Decimal? @map("monthly_budget") @db.Decimal(10, 2)
  /// 预算告警阈值（0-1）
  alertThreshold     Decimal? @default(0.8) @map("alert_threshold") @db.Decimal(3, 2)
  /// 是否启用自动降级
  autoDowngrade      Boolean  @default(false) @map("auto_downgrade")
  /// 降级目标模型
  downgradeModel     String?  @map("downgrade_model") @db.VarChar(100)

  // ============ 复杂度路由配置 ============
  /// 是否启用复杂度路由
  complexityRoutingEnabled  Boolean @default(false) @map("complexity_routing_enabled")
  /// 复杂度路由配置 ID
  complexityRoutingConfigId String? @map("complexity_routing_config_id") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([routingEnabled])
  @@index([costControlEnabled])
  @@index([complexityRoutingEnabled])
  @@map("b_bot_routing_config")
}

/// ComplexityRoutingConfig - 复杂度路由配置
/// 存储基于消息复杂度的模型路由配置
model ComplexityRoutingConfig {
  id       String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 配置唯一标识符
  configId String @unique @map("config_id") @db.VarChar(50)
  /// 配置名称
  name     String @db.VarChar(100)
  /// 配置描述
  description String? @db.Text

  // ============ 模型配置 ============
  /// @deprecated 旧的 JSON 模型配置，迁移到 ComplexityRoutingModelMapping 关联表后移除
  /// 格式: { super_easy: {vendor, model}, easy: {...}, medium: {...}, hard: {...}, super_hard: {...} }
  models Json? @db.JsonB

  // 新：通过关联表引用实际可用模型
  modelMappings ComplexityRoutingModelMapping[]

  // ============ 分类器配置 ============
  /// 分类器使用的模型
  classifierModel  String @default("deepseek-v3-250324") @map("classifier_model") @db.VarChar(100)
  /// 分类器使用的 vendor
  classifierVendor String @default("deepseek") @map("classifier_vendor") @db.VarChar(50)

  // ============ 行为配置 ============
  /// 工具调用时的最低复杂度
  toolMinComplexity String? @map("tool_min_complexity") @db.VarChar(20)

  // ============ 状态 ============
  /// 是否启用
  isEnabled Boolean @default(true) @map("is_enabled")
  /// 是否为内置配置
  isBuiltin Boolean @default(false) @map("is_builtin")
  /// 软删除标记
  isDeleted Boolean @default(false) @map("is_deleted")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([configId])
  @@index([isEnabled])
  @@index([isDeleted])
  @@map("b_complexity_routing_config")
}

/// FallbackChainModel - Fallback 链模型关联表
/// 引用 ModelCatalog（模型级别），运行时动态解析到可用 vendor
model FallbackChainModel {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 关联的 FallbackChain ID
  fallbackChainId String   @map("fallback_chain_id") @db.Uuid
  /// 关联的 ModelCatalog ID（模型级别，运行时解析到可用 vendor）
  modelCatalogId  String   @map("model_catalog_id") @db.Uuid
  /// 在链中的顺序（0 = 首选模型，数值越小优先级越高）
  priority        Int      @default(0)
  /// 协议覆盖（可选，默认使用 ProviderKey 的 apiType）
  protocolOverride    String?  @map("protocol_override") @db.VarChar(50)
  /// 特性覆盖配置（JSON），如 { extendedThinking: true, cacheControl: true }
  featuresOverride    Json?    @map("features_override") @db.JsonB

  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fallbackChain FallbackChain @relation(fields: [fallbackChainId], references: [id], onDelete: Cascade)
  modelCatalog  ModelCatalog  @relation(fields: [modelCatalogId], references: [id], onDelete: Cascade)

  @@unique([fallbackChainId, modelCatalogId])
  @@index([fallbackChainId])
  @@index([modelCatalogId])
  @@index([priority])
  @@map("b_fallback_chain_model")
}

/// ComplexityRoutingModelMapping - 复杂度路由模型映射表
/// 引用 ModelCatalog（模型级别），运行时动态解析到可用 vendor
model ComplexityRoutingModelMapping {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// 关联的 ComplexityRoutingConfig ID
  complexityConfigId    String   @map("complexity_config_id") @db.Uuid
  /// 复杂度级别：super_easy, easy, medium, hard, super_hard
  complexityLevel       String   @map("complexity_level") @db.VarChar(20)
  /// 关联的 ModelCatalog ID（模型级别）
  modelCatalogId        String   @map("model_catalog_id") @db.Uuid
  /// 在同级别中的优先级（0 = 首选）
  priority              Int      @default(0)

  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  complexityConfig  ComplexityRoutingConfig @relation(fields: [complexityConfigId], references: [id], onDelete: Cascade)
  modelCatalog      ModelCatalog            @relation(fields: [modelCatalogId], references: [id], onDelete: Cascade)

  @@unique([complexityConfigId, complexityLevel, modelCatalogId])
  @@index([complexityConfigId])
  @@index([modelCatalogId])
  @@index([complexityLevel])
  @@map("b_complexity_routing_model_mapping")
}
